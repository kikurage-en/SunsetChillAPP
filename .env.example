# Location
LOCATION_NAME=逗子海岸
LATITUDE=35.2956
LONGITUDE=139.5736
TIMEZONE=Asia/Tokyo

# LINE
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TARGET_ID=
LINE_CHANNEL_SECRET=
LINE_BOT_USER_ID=

# Live camera image
LIVE_CAMERA_URL=https://www.youtube.com/watch?v=Q5AAi9KOjG0
LIVE_CAMERA_VIDEO_ID=Q5AAi9KOjG0
LIVE_CAMERA_IMAGE_BASE_URL=
LIVE_CAMERA_IMAGE_URL=
LIVE_CAMERA_PREVIEW_IMAGE_URL=
LIVE_CAMERA_PUBLIC_DIR=public
LIVE_CAMERA_CAPTURE_TIMEOUT_SECONDS=20

# Form
GOOGLE_FORM_URL=

# Storage
STORAGE_BACKEND=csv
CSV_PATH=logs/chill_predictions.csv
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WORKSHEET=predictions
GOOGLE_SERVICE_ACCOUNT_JSON=

# Runtime
DRY_RUN=false
LOG_LEVEL=INFO
ALLOW_MISSING_HOURLY_FIELDS=

# Webhook server
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8080

# GitHub Actions trigger
GITHUB_REPOSITORY=kikurage-en/SunsetChillAPP
GITHUB_WORKFLOW=daily_chill.yml
GITHUB_REF=main
GITHUB_TOKEN=

# Vision LLM (live-camera image analysis, runs only at hours in VISION_TARGET_HOURS)
VISION_ENABLED=false
VISION_API_KEY=
VISION_MODEL=gemini-2.5-flash
VISION_TIMEOUT_SECONDS=30
# 日没+20分の実行を通年カバー(冬16時台〜夏19時台)。旧 VISION_TARGET_HOUR も後方互換。
VISION_TARGET_HOURS=16,17,18,19

# Sunset期待度の雲量を、当日の日没方位へ何km西へ離れた地点から取得するか(既定40、0で無効=逗子の雲量を使用)
SUNSET_CLOUD_OFFSET_KM=40

# 日没前のVisionカメラAI予測を Sunset期待度の表示値へブレンドする際の Vision の重み(0〜1、既定0.8=Vision8割、0で無効)
# 純式スコア sunset_score は上書きせず、ブレンド値は final_sunset_score 列に記録
SUNSET_VISION_BLEND_WEIGHT=0.8

# Sunsethue API による独立ベンチマーク(log-only、スコアには影響しない)。ray-modelの夕焼け品質予測を記録
# 有効化には SUNSETHUE_ENABLED=true と SUNSETHUE_API_KEY が必要。無料枠1000creds/日・非商用
SUNSETHUE_ENABLED=false
SUNSETHUE_API_KEY=
SUNSETHUE_TIMEOUT_SECONDS=20
